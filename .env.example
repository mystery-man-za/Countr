# SCALARAI_MCP_API_KEY: Bearer token guarding the MCP endpoint and every
# state-changing route (settings, trade control, EA ingestion, market updates).
#
# The server FAILS CLOSED: if this is unset or blank those routes return 503
# rather than serving unauthenticated. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SCALARAI_MCP_API_KEY="REPLACE_WITH_A_RANDOM_SECRET"

# PORT: Backend server port (default 3000).
PORT=3000

# FRONTEND_URL: Allowed CORS origin for the Vite dev server (default http://localhost:5173).
FRONTEND_URL=http://localhost:5173

# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and EA generator endpoints.
APP_URL="MY_APP_URL"

# GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET: GitHub OAuth Application credentials,
# used by the optional Git sync feature.
# WARNING: Never commit real credentials. Use environment variables or a secrets manager.
GITHUB_CLIENT_ID="REPLACE_WITH_YOUR_GITHUB_CLIENT_ID"
GITHUB_CLIENT_SECRET="REPLACE_WITH_YOUR_GITHUB_CLIENT_SECRET"

# Explicit Git Sync Target Configuration
GITHUB_REPO_OWNER=Faarhan01
GITHUB_REPO_NAME=Scalarai

# NOTE: GEMINI_API_KEY is intentionally absent - no code path uses the Gemini API
# (the @google/genai dependency was removed as unused).